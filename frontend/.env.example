# MusicMirror Environment Configuration Example
# ---
# Copy this file to .env.local for local development settings.
# NEVER commit real private credentials or access tokens.

# API Base URL for backend microservices
VITE_API_BASE_URL=http://localhost:8000

# Jamendo Public Client ID for Royalty-Free CC Audio API v3.0
VITE_JAMENDO_CLIENT_ID=c8993883

# ── Version & Mode ────────────────────────────────────────────────────────────
# Controls whether this deployment is BASELINE (V1 production) or DEVELOPER (V2 preview/dev).
# BASELINE: served from v1-production branch → https://music-mirror-aos.vercel.app/
# DEVELOPER: served from main branch → Vercel preview URL
# If unset: production Vite builds default to BASELINE, dev server defaults to DEVELOPER.
VITE_APP_MODE=DEVELOPER

# Internal build metadata — auto-set by CI pipeline; safe to omit locally.
VITE_APP_SEMVER=2.06.05.0
VITE_GIT_BRANCH=main
# VITE_BUILD_TIMESTAMP= (set automatically in CI)
